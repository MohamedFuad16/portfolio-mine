# Server-only variables for the optional Upstash visitor counter.
# Never prefix these with VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional salt used when deriving the short-lived visitor de-duplication key.
VISITS_SALT=

# scripts/fetch-contributions.mjs (also set in .github/workflows/update-contributions.yml)
# Time zone the GitHub contribution calendar buckets pull requests and issues by.
GH_TIME_ZONE=Asia/Tokyo
