vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    center: true
  }
}
direction: down

visitor: "Portfolio visitor" {shape: person}

browser: "Browser" {
  shell: "Vite + analytics entry"
  app: "React App"
  cards: "Project cards"
  details: "Detail overlay"
  activity: "Contribution grid"
  mascot: "Daijin mascot"
  analytics: "Virtual page views"

  shell -> app
  app -> cards
  cards -> details: "full-card clone + measured rect"
  app -> activity
  app -> mascot: "section triggers once + hold"
  app -> analytics
}

presentation: "Presentation" {
  styles: "Responsive CSS"
  motion: "GSAP motion"
  audio: "Achievement chime"
}

content: "Local content" {
  data: "EN / JA data"
  media: "Project assets"
  mascot_media: "Daijin WebP pairs"
  resume: "Resume PDFs"
}

services: "External services" {
  github: "GitHub contributions API" {shape: cloud}
  analytics: "Vercel Web Analytics" {shape: cloud}
  visits: "Vercel visits function" {shape: cloud}
  redis: "Upstash Redis" {shape: cylinder}

  visits -> redis: "de-duplicated count"
}

visitor -> browser.shell: "visit / interact"
browser.app -> presentation.styles
browser.app -> presentation.motion
browser.app -> presentation.audio
browser.app -> content.data
browser.cards -> content.media
browser.app -> content.resume
browser.activity -> services.github: "rolling 12 months"
browser.mascot -> content.mascot_media: "selected canvas frames"
browser.analytics -> services.analytics: "sanitized paths"
browser.app -> services.visits: "footer count"
